# Asian Sofa - environment template
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# Vite only exposes variables prefixed with VITE_.

# Production site origin, used for canonical URLs, Open Graph tags and sitemap.
VITE_SITE_URL=https://www.asiansofa.in

# Optional: Google Tag Manager container ID.
# Tracking events are already wired (see src/lib/tracking.js) and pushed to
# window.dataLayer. No container ID is inserted by this project — paste the GTM
# snippet into index.html once the client supplies a real ID. Never commit one.
# VITE_GTM_ID=GTM-XXXXXXX

# Optional: Formspree / backend endpoint for the contact enquiry form.
# Leave blank to keep the form in "WhatsApp handoff" mode (no data is sent anywhere).
# VITE_ENQUIRY_ENDPOINT=
